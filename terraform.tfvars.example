# Copy to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars, it may contain sensitive values.

aws_region = "us-east-2"

project     = "ekslab"
environment = "dev"
cluster_name = "galaxy"

vpc_cidr = "10.0.0.0/16"

# Cost-optimized defaults, change only if needed
enable_nat_gateway_per_az = false
enable_flow_logs          = false

cluster_version = "1.35"

node_instance_type = "t3.medium"
node_desired_size  = 1
node_min_size      = 1
node_max_size      = 3

# Optional tuning knobs, defaults shown below.
# az_count            = 2
# log_retention_days  = 7
# node_volume_size    = 20

# Optional: IAM principal for permanent local kubectl access.
# If omitted, only the identity that ran terraform apply gets cluster admin (via bootstrap).
# admin_principal_arn = "arn:aws:iam::123456789012:user/your-username"

# Sensitive values - pass via environment variables or GitHub secrets, not here.
# export TF_VAR_allowed_cidrs='["YOUR_IP/32"]'
